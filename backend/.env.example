# ==========================================
# FastAPI Backend Environment Variables
# ==========================================

# Environment mode: development or production
ENVIRONMENT=production

# Server network binding (Port 8001 avoids internal container control plane port 8000)
HOST=0.0.0.0
PORT=8001

# Allowed origins for CORS (comma-separated list of trusted frontend origins)
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.vercel.app

# Upstream mock API base URLs (supports separate microservices or unified instance)
CRM_API_BASE_URL=http://127.0.0.1:8001
HELPDESK_API_BASE_URL=http://127.0.0.1:8001

# Outbound HTTP client request timeout in seconds
REQUEST_TIMEOUT_SECONDS=3.5

# Canonical business timezone for deadline calculations
BUSINESS_TIMEZONE=UTC

# ==========================================
# Authentication & Security Configuration
# ==========================================

# JWT Secret Signing Key: Must be at least 32 characters in production. Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS

# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Persistent SQLite database file path (upgrade path to PostgreSQL supported via connection string)
DATABASE_PATH=backend/data/users.db

# Initial Administrator Provisioning (Refuses to overwrite an existing administrator)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@workflow.local
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Login Rate Limiting (max failed attempts within window in seconds)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
