# ==========================================
# React / Vite Frontend Environment Variables
# ==========================================

# VITE_API_BASE_URL: Backend API base URL for FastAPI / API requests.
# In local development: empty string uses Vite reverse proxy, or "http://localhost:8001"
# In production: "https://your-backend-service.onrender.com"
VITE_API_BASE_URL="http://localhost:8001"

# GEMINI_API_KEY: (Optional) Configured in AI Studio UI Secrets panel
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected automatically in preview environments)
APP_URL="MY_APP_URL"
